{
  "name": "chokei",
  "version": "2.0.2",
  "description": "日本の石造物などを地図上に表示するためのアイコンをオープンデータで公開します。",
  "private": true,
  "main": "index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./index.js"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "import": "./dist/convert.mjs",
      "require": "./dist/convert.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "inkscape": "piconvert install",
    "convert": "node scripts/convert-legacy.mjs",
    "verify:renderer": "node scripts/verify-renderer-equivalence.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code4history/Chokei.git"
  },
  "keywords": [
    "Icon",
    "Map",
    "Cultural",
    "assets"
  ],
  "author": "Code for History",
  "license": "CC-BY-SA-4.0",
  "bugs": {
    "url": "https://github.com/code4history/Chokei/issues"
  },
  "homepage": "https://github.com/code4history/Chokei#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@xmldom/xmldom": "^0.9.12",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.1.0",
    "piconvert": "0.5.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.4",
    "xpath": "^0.0.35"
  }
}
